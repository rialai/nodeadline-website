  "rules": [
    { "when": { "resources": "vehicles" },
      "addNode": { "id": "vehicles", "type": "tools", "label": "Vehicles", "functions": ["Deliver / collect"] },
      "addEdges": [ { "to_hub": ["jobs", "work", "counter", "customers"], "from": "vehicles", "kind": "flow", "label": "deliver" } ] },

    { "when": { "resources": "premises" },
      "addNode": { "id": "premises", "type": "tools", "label": "Premises", "functions": ["Where it happens"] },
      "addEdges": [ { "from_hub": ["owner"], "to": "premises", "kind": "flow", "label": "rent / run" } ] },

    { "when": { "resources": "software" },
      "addNode": { "id": "software", "type": "documents", "label": "Software", "functions": ["Records & admin", "Usually scattered"] },
      "addEdges": [ { "from_hub": ["owner"], "to": "software", "kind": "flow", "label": "records" } ] },

    { "when": { "cafe_delivery": "yes" },
      "addNode": { "id": "delivery", "type": "external", "label": "Delivery apps", "functions": ["Online orders", "Take a cut"] },
      "addEdges": [ { "from": "counter", "to": "delivery", "kind": "transaction", "label": "orders" }, { "from": "delivery", "to": "money", "kind": "transaction", "label": "payout" } ] },

    { "when": { "retail_channel": "online" },
      "addNode": { "id": "online", "type": "external", "label": "Online shop", "functions": ["Sell beyond the door"] },
      "addEdges": [ { "from": "online", "to": "money", "kind": "transaction", "label": "sales" }, { "from_hub": ["inputs", "work"], "to": "online", "kind": "flow", "label": "ship" } ] },

    { "when": { "pain": "suppliers" }, "highlightNode": "suppliers",
      "hint": { "node": "suppliers", "type": "automate", "text": "Auto-compare supplier prices — buy the cheapest, every time." } },

    { "when": { "pain": "staff" }, "highlightNode": ["staff", "mechanics", "team"],
      "hint": { "node": ["staff", "mechanics", "team"], "type": "save", "text": "Spare-staff cover with task cards when someone's out." } },

    { "when": { "pain": "cashflow" }, "highlightNode": "money",
      "hint": { "node": "money", "type": "automate", "text": "See cash in and out before it bites." } },

    { "when": { "pain": "time" }, "highlightNode": "owner",
      "hint": { "node": "owner", "type": "save", "text": "Take the daily admin off your plate." } },

    { "when": { "pain": "chaos" }, "highlightNode": "owner",
      "hint": { "node": "owner", "type": "automate", "text": "One clear picture instead of ten chats." } }
