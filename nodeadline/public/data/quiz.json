{
  "_note": "Quiz schema (TZ §6.1). Mouse/tap only, no contact asked before the result. Branch questions appear via showIf. OWNER: review/extend the per-type branch questions — these are the §14 content item.",
  "questions": [
    {
      "id": "biz_type",
      "type": "single",
      "title": "What do you run?",
      "maps_to": "skeleton",
      "options": [
        { "value": "cafe", "label": "Café / restaurant" },
        { "value": "auto", "label": "Auto-service" },
        { "value": "production", "label": "Production / workshop" },
        { "value": "trades", "label": "Trades (builder, electrician…)" },
        { "value": "services", "label": "Services / agency" },
        { "value": "retail", "label": "Shop / retail" },
        { "value": "other", "label": "Something else" }
      ]
    },
    {
      "id": "people",
      "type": "single",
      "title": "How many people work in it?",
      "options": [
        { "value": "solo", "label": "Just me" },
        { "value": "2-5", "label": "2–5" },
        { "value": "6-15", "label": "6–15" },
        { "value": "15+", "label": "15+" }
      ]
    },
    {
      "id": "resources",
      "type": "multi",
      "title": "What does it run on?",
      "subtitle": "Pick all that apply.",
      "maps_to": "addNodes",
      "options": [
        { "value": "people", "label": "People / staff" },
        { "value": "materials", "label": "Materials / stock" },
        { "value": "tools", "label": "Tools / equipment" },
        { "value": "premises", "label": "Premises" },
        { "value": "vehicles", "label": "Vehicles" },
        { "value": "suppliers", "label": "Suppliers" },
        { "value": "software", "label": "Software" }
      ]
    },
    {
      "id": "control",
      "type": "single",
      "title": "Where does it all live today?",
      "options": [
        { "value": "head", "label": "In my head" },
        { "value": "chats", "label": "Chats / WhatsApp" },
        { "value": "spreadsheets", "label": "Spreadsheets" },
        { "value": "crm", "label": "A CRM / system" },
        { "value": "paper", "label": "Paper" }
      ]
    },
    {
      "id": "pain",
      "type": "single",
      "title": "What bugs you most?",
      "maps_to": "hint",
      "options": [
        { "value": "staff", "label": "Staff turnover" },
        { "value": "suppliers", "label": "Suppliers / costs" },
        { "value": "cashflow", "label": "Cash flow" },
        { "value": "time", "label": "No time" },
        { "value": "chaos", "label": "General chaos" }
      ]
    },
    {
      "id": "turnover",
      "type": "single",
      "title": "Roughly, monthly turnover?",
      "subtitle": "Private — only used to size the picture.",
      "maps_to": "qualify",
      "options": [
        { "value": "lt3k", "label": "Under €3k" },
        { "value": "3-10k", "label": "€3–10k" },
        { "value": "10-50k", "label": "€10–50k" },
        { "value": "50k+", "label": "€50k+" }
      ]
    },

    { "id": "cafe_service", "type": "single", "title": "Table service, counter, or both?",
      "showIf": { "biz_type": ["cafe"] },
      "options": [
        { "value": "table", "label": "Table" },
        { "value": "counter", "label": "Counter" },
        { "value": "both", "label": "Both" }
      ]
    },
    { "id": "cafe_delivery", "type": "single", "title": "Takeaway / delivery apps?",
      "showIf": { "biz_type": ["cafe"] },
      "options": [
        { "value": "yes", "label": "Yes" },
        { "value": "no", "label": "No" }
      ]
    },
    { "id": "auto_booking", "type": "single", "title": "Bookings or walk-in?",
      "showIf": { "biz_type": ["auto"] },
      "options": [
        { "value": "bookings", "label": "Mostly bookings" },
        { "value": "walkin", "label": "Mostly walk-in" },
        { "value": "both", "label": "Both" }
      ]
    },
    { "id": "auto_parts", "type": "single", "title": "Do you hold parts in stock?",
      "showIf": { "biz_type": ["auto"] },
      "options": [
        { "value": "yes", "label": "Yes, a store" },
        { "value": "order", "label": "Order per job" }
      ]
    },
    { "id": "prod_mode", "type": "single", "title": "Make to order or to stock?",
      "showIf": { "biz_type": ["production"] },
      "options": [
        { "value": "order", "label": "To order" },
        { "value": "stock", "label": "To stock" },
        { "value": "both", "label": "Both" }
      ]
    },
    { "id": "trades_quote", "type": "single", "title": "Do you quote before each job?",
      "showIf": { "biz_type": ["trades"] },
      "options": [
        { "value": "yes", "label": "Yes, always" },
        { "value": "sometimes", "label": "Sometimes" }
      ]
    },
    { "id": "services_booking", "type": "single", "title": "Do clients book appointments?",
      "showIf": { "biz_type": ["services"] },
      "options": [
        { "value": "yes", "label": "Yes" },
        { "value": "no", "label": "No, project work" }
      ]
    },
    { "id": "retail_channel", "type": "single", "title": "Shop only, or online too?",
      "showIf": { "biz_type": ["retail"] },
      "options": [
        { "value": "shop", "label": "Shop only" },
        { "value": "online", "label": "Shop + online" }
      ]
    }
  ]
}
